# Non-secret settings for the paper VM's services. Copy to ~/.config/copilot/copilot.env.
# systemd EnvironmentFile syntax: KEY=value, no `export`, no quotes needed.

# Broker: the local Gateway container's paper port.
IB_V2_HOST=127.0.0.1
IB_V2_PORT=4002
COPILOT_PAPER_ACCOUNT=CHANGE-ME

# Required by every IB connect until measured as unnecessary against an Eastern Gateway.
IBAPI_TIMEZONE_ALIASES=JST=Asia/Tokyo

# Display only: the second clock `day` prints beside Eastern.
COPILOT_OPERATOR_TZ=America/New_York

# Data, outside the repository.
COPILOT_CATALOG_PATH=/home/CHANGE-ME/.nautilus_copilot/catalog

# The watcher's push URL; every morning pings it. Unset, nothing outside notices a stop.
COPILOT_HEARTBEAT_URL=

# CRITICAL alert retry and deadline (ADR-0023): two minutes, one hour.
COPILOT_ALERT_RETRY_SECONDS=120
COPILOT_ALERT_EXPIRE_SECONDS=3600

# The extension's runtime library path; derive it on the VM:
#   .venv/bin/python -c 'import sysconfig;print(sysconfig.get_config_var("LIBDIR"))'
LD_LIBRARY_PATH=CHANGE-ME
